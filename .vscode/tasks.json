{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all (release)",
            "type": "shell",
            "command": "./build.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build all (debug)",
            "type": "shell",
            "command": "./build.sh --debug",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build (select project)",
            "type": "shell",
            "command": "./build.sh ${input:project}",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build debug (Common + examples)",
            "type": "shell",
            "command": "./build.sh --debug --examples Common",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build examples (release)",
            "type": "shell",
            "command": "./build.sh --examples",
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "run examples (terminal)",
            "type": "shell",
            "command": "./build.sh --examples && ./build/release/examples/nothrow_demo",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "debug nothrow_demo (VS Code)",
            "type": "command",
            "command": "workbench.action.debug.selectAndStartDebugging"
        },
        {
            "label": "run tests (terminal)",
            "type": "shell",
            "command": "./build.sh --tests",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "generate compile_commands",
            "type": "shell",
            "command": "./build.sh --compiledb",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "refresh clangd",
            "dependsOn": [
                "generate compile_commands"
            ],
            "type": "command",
            "command": "clangd.restart"
        },
        {
            "label": "clean all",
            "type": "shell",
            "command": "./build.sh --clean",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "run demo server (terminal)",
            "type": "shell",
            "command": "./build.sh Demo && ./build/release/demo",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "run demo client (terminal)",
            "type": "shell",
            "command": "./build.sh Demo && ./build/release/demo_client",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "project",
            "type": "promptString",
            "description": "输入要构建的项目名（空格分隔，如：Common ServerCore）",
            "default": "Common"
        }
    ]
}
