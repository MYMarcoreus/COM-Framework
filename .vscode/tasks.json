{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build (all projects)",
            "type": "shell",
            "command": "bash build-all.sh",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "generate compile_commands (all projects)",
            "type": "shell",
            "command": "bash generate-compiledb.sh",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "run demo server",
            "type": "shell",
            "command": "./build/demo",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "run demo client",
            "type": "shell",
            "command": "./build/demo_client",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build examples",
            "type": "shell",
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}/examples"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build examples (debug)",
            "type": "shell",
            "command": "bash -c 'make -C Common/Linux clean && make -C Common/Linux debug && make -C examples clean && make -C examples CXXFLAGS=\"-std=c++11 -Wall -Wextra -O0 -g -pthread\"'",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "clean (all projects)",
            "type": "shell",
            "command": "bash -c 'for p in Common ServerCore Demo; do make -C \"$PWD/$p/Linux\" clean; done'",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ]
}
