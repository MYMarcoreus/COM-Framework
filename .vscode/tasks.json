{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build all (release)",
            "type": "shell",
            "command": "./build.sh",
            "dependsOn": [
                "generate compile_commands"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build all (debug)",
            "type": "shell",
            "command": "./build.sh --debug",
            "dependsOn": [
                "generate compile_commands"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build (select project)",
            "type": "shell",
            "command": "./build.sh ${input:mode} ${input:project}",
            "dependsOn": [
                "generate compile_commands"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build (project menu)",
            "type": "shell",
            "command": ".tools/project_menu.sh build",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "debug (project menu)",
            "type": "shell",
            "command": ".tools/project_menu.sh debug",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "run (project menu)",
            "type": "shell",
            "command": ".tools/project_menu.sh run",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "debug (select project)",
            "type": "shell",
            "command": "./build.sh --debug ${input:project}",
            "dependsOn": [
                "generate compile_commands"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "run (select project)",
            "type": "shell",
            "command": "bash .tools/project_menu.sh run ${input:project} ${input:mode}",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "build debug (Common + examples)",
            "type": "shell",
            "command": "./build.sh --debug Common examples",
            "dependsOn": [
                "generate compile_commands"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build examples (release)",
            "type": "shell",
            "command": "./build.sh examples",
            "dependsOn": [
                "generate compile_commands"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "build demo (release)",
            "type": "shell",
            "command": "./build.sh Common ServerCore Demo",
            "dependsOn": [
                "generate compile_commands"
            ],
            "problemMatcher": [
                "$gcc"
            ],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "run examples (terminal)",
            "type": "shell",
            "command": "./build/release/examples/examples",
            "dependsOn": [
                "build examples (release)"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "run tests (terminal)",
            "type": "shell",
            "command": "./build/release/tests",
            "dependsOn": [
                "build all (release)"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "generate compile_commands",
            "type": "shell",
            "command": "./build.sh --compiledb",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "clean all",
            "type": "shell",
            "command": "./build.sh --clean",
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "label": "run demo server (terminal)",
            "type": "shell",
            "command": "./build/release/demo",
            "dependsOn": [
                "build demo (release)"
            ],
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        },
        {
            "label": "run demo client (terminal)",
            "type": "shell",
            "command": "./build/release/demo_client",
            "dependsOn": [
                "build demo (release)"
            ],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        }
    ],
    "inputs": [
        {
            "id": "mode",
            "type": "pickString",
            "description": "选择构建模式",
            "options": [
                { "label": "debug（默认）", "value": "--debug" },
                { "label": "release", "value": "--release" }
            ],
            "default": "--debug"
        },
        {
            "id": "project",
            "type": "command",
            "command": "shellCommand.execute",
            "args": {
                "command": "./build.sh --list",
                "cwd": "${workspaceFolder}",
                "description": "选择项目（自动发现，可手动输入新项目）",
                "allowCustomValues": true
            }
        }
    ]
}
