# ====================================================================
# COM-Framework clang-format 配置
#
# 以 Common/Async/AsyncExecutorNoThrow.h/.cpp 的实际排版为准重写。
# 遵循项目 C++11 开发规范：
#   - 4 空格缩进，不使用 Tab；
#   - Allman 花括号风格（函数/类/控制语句花括号换行，namespace 保持 attach）；
#   - 二元运算符换行时留在行尾（= / && / || …），. / -> 恒换到行首；
#   - 嵌套模板闭合角括号保留空格（CTask<U> >，Standard: Cpp03）；
#   - #if 内的预处理指令按嵌套层级缩进（BeforeHash）；
#   - lambda 花括号换行、体按外层作用域缩进（OuterScope）。
#
# 注意：LambdaBodyIndentation 需要 clang-format >= 13
#       （clangd / clang-format 13 及以上版本支持）。
# ====================================================================

BasedOnStyle: Google

# ---- 标准 / 模板 ----
# C++11 项目，但代码统一写作 C++03 式「> >」（如 CTask<U> > / std::vector<int> >），
# 用 Cpp03 保留闭合角括号间的空格（Cpp11+ 会合并为 >>）。
Standard: Cpp03

# ---- 缩进 ----
IndentWidth: 4
TabWidth: 4
UseTab: Never
ContinuationIndentWidth: 4
NamespaceIndentation: None
# access 修饰符（public: / private: / protected:）不额外缩进：与所属 class / struct
# 关键字对齐（顶层类即顶格，嵌套类与其 class 关键字同列），成员照常缩进 4 格。
AccessModifierOffset: -4
# #if / #else / #endif 内的指令按嵌套层级缩进（#define 缩进 4 格）。
IndentPPDirectives: BeforeHash

# ---- 列宽 ----
ColumnLimit: 120

# ---- 对齐 ----
# 续行不按开括号对齐，只缩进一个 ContinuationIndentWidth（4 格）：
# lambda 实参、长参数表都按「多缩进一级」排，不会拉到 40+ 列去对齐。
# 该选项全局生效，**无法**把「函数形参表」与「实参表」分开设置：
# 选 DontAlign = 统一缩进一级（含形参）；若改回 Align，形参会对齐、但内联 lambda 实参
# 会被推到 30–70 列。取舍理由与实测记录见 docs/vscode-clangd-format.md §6。
AlignAfterOpenBracket: DontAlign
# 行尾注释列对齐（成员变量注释、using 别名注释等）。
AlignTrailingComments: true
# **不要**按文件内容推导指针风格（Google 基准默认开启，会盖掉下面的 PointerAlignment）。
DerivePointerAlignment: false
# 指针/引用贴近类型名（const char* / const TValue&）。
PointerAlignment: Left
# 参数允许装箱（一行放多个参数），首参保留在首行。
BinPackParameters: true
BinPackArguments: true
AllowAllParametersOfDeclarationOnNextLine: true
AllowAllArgumentsOnNextLine: true

# ---- 花括号（Custom 精确控制）----
BreakBeforeBraces: Custom
BraceWrapping:
  AfterClass: true
  AfterControlStatement: Always
  AfterEnum: true
  AfterFunction: true
  AfterNamespace: false
  AfterStruct: true
  AfterUnion: true
  AfterExternBlock: true
  BeforeCatch: true
  BeforeElse: true
  BeforeLambdaBody: true
  BeforeWhile: false
  IndentBraces: false
  SplitEmptyFunction: false
  SplitEmptyRecord: true
  SplitEmptyNamespace: true

# ---- 换行 ----
# **不要**重排注释内容（Google 基准默认开启，会把对齐好的注释表 / 图示 / 列表揉成散文）。
ReflowComments: false
# 二元运算符换行时留在行尾（if (a || b ||\n    c)）；
# 成员访问 . / -> 为 clang-format 固有行为，恒换到行首（链式调用）。
BreakBeforeBinaryOperators: None
# 构造函数初始化列表：冒号换到行首，后续初始化项对齐其下。
BreakConstructorInitializers: BeforeColon
# 保留大节分隔的连续空行（AsyncExecutorNoThrow.h 中节前最多 7 行）。
MaxEmptyLinesToKeep: 7

# ---- 短语句 ----
# 函数体一律不写在单行（含类内定义）：声明与 body 分行更清晰。
AllowShortFunctionsOnASingleLine: None
# if 无 else 时允许单行（如 if (n < 0) return no::None;）。
AllowShortIfStatementsOnASingleLine: WithoutElse

# ---- 空格 ----
# C 风格强转后不加空格：(void)loc;
SpaceAfterCStyleCast: false

# ---- lambda ----
# lambda 花括号换行（BeforeLambdaBody: true），体按**签名所在行**再多缩进一级
# （Signature：内联在实参列表里的 lambda 体也会缩进一次，不会掉回外层作用域）。
LambdaBodyIndentation: Signature
# lambda 体也不写在单行（Google 基准默认 All 会把 { return x; } 压成一行）。
AllowShortLambdasOnASingleLine: None

# ---- 杂项（Google 默认，与代码一致，显式声明）----
# 命名空间闭合注释：} // namespace detail
FixNamespaceComments: true
# include 分类排序（系统 <...> 在前、项目 "..." 在后）。
IncludeBlocks: Regroup
SortIncludes: true
